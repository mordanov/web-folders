server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name ${COOKING_COURSE_SERVER_NAMES};

    ssl_certificate /etc/letsencrypt/live/${COOKING_COURSE_PRIMARY_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${COOKING_COURSE_PRIMARY_DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    # Large static files (videos/PDFs)
    client_max_body_size 0;

    location / {
        set $cooking_course http://cooking-course:8000;
        proxy_pass $cooking_course;
        include /etc/nginx/snippets/proxy-common.conf;
        proxy_read_timeout 60s;
    }
}
