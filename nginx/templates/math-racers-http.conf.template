server {
    listen 80;
    listen [::]:80;
    server_name ${MATH_RACERS_SERVER_NAMES};

    # ACME challenge for certbot
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location /api/ {
        set $math_racers_backend http://math-racers-backend:8000;
        proxy_pass $math_racers_backend;
        include /etc/nginx/snippets/proxy-common.conf;
        proxy_read_timeout 120s;
    }

    location /health {
        set $math_racers_backend http://math-racers-backend:8000;
        proxy_pass $math_racers_backend;
        include /etc/nginx/snippets/proxy-common.conf;
    }

    location / {
        set $math_racers_frontend http://math-racers-frontend:80;
        proxy_pass $math_racers_frontend;
        include /etc/nginx/snippets/proxy-common.conf;
    }
}
