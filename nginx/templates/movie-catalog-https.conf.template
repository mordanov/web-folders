server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name ${MOVIECATALOG_SERVER_NAMES};

    ssl_certificate /etc/letsencrypt/live/${MOVIECATALOG_PRIMARY_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${MOVIECATALOG_PRIMARY_DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    location /api/ {
        set $movie_catalog_backend http://movie-catalog-backend:8000;
        proxy_pass $movie_catalog_backend;
        include /etc/nginx/snippets/proxy-common.conf;
        proxy_read_timeout 60s;
    }

    location / {
        set $movie_catalog_frontend http://movie-catalog-web:80;
        proxy_pass $movie_catalog_frontend;
        include /etc/nginx/snippets/proxy-common.conf;
    }
}
