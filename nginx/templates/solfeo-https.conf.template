server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name ${SOLFEO_SERVER_NAMES};

    ssl_certificate /etc/letsencrypt/live/${SOLFEO_PRIMARY_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${SOLFEO_PRIMARY_DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    location / {
        set $solfeo_frontend http://solfeo-product-frontend:8080;
        proxy_pass $solfeo_frontend;
        include /etc/nginx/snippets/proxy-common.conf;
        proxy_read_timeout 180s;
    }
}
