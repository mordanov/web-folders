server {
    listen 80;
    listen [::]:80;
    server_name ${SOLFEO_PWA_PROTOTYPE_SERVER_NAMES};

    if ($request_method !~ ^(GET|HEAD)$) {
        return 405;
    }

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}
